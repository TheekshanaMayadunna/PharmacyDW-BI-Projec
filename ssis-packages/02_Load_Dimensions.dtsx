    <DTS:Executable
      DTS:refId="Package\Load DimDate"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{A55D3AA8-FA4A-48F9-A2C4-D25EBEB0A750}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Load DimDate"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{81C61F29-D818-4998-911B-E59F70B0E14F}"
          SQLTask:SqlStatementSource="DECLARE @date DATE = '2022-01-01';&#xA;DECLARE @end DATE = '2023-06-30';&#xA;&#xA;WHILE @date &lt;= @end&#xA;BEGIN&#xA;    IF NOT EXISTS (SELECT 1 FROM DimDate WHERE DateKey = CAST(FORMAT(@date,'yyyyMMdd') AS INT))&#xA;    BEGIN&#xA;        INSERT INTO DimDate (&#xA;            DateKey, FullDate, Year, Quarter, QuarterName, Month, MonthName, &#xA;            Week, Day, DayName, DayOfWeek, IsWeekend, IsHoliday&#xA;        )&#xA;        VALUES (&#xA;            CAST(FORMAT(@date,'yyyyMMdd') AS INT),&#xA;            @date,&#xA;            YEAR(@date),&#xA;            DATEPART(QUARTER,@date),&#xA;            'Q' + CAST(DATEPART(QUARTER,@date) AS NVARCHAR(1)),&#xA;            MONTH(@date),&#xA;            DATENAME(MONTH,@date),&#xA;            DATEPART(WEEK,@date),&#xA;            DAY(@date),&#xA;            DATENAME(WEEKDAY,@date),&#xA;            DATEPART(WEEKDAY,@date),&#xA;            CASE WHEN DATEPART(WEEKDAY,@date) IN (1,7) THEN 1 ELSE 0 END,&#xA;            0&#xA;        );&#xA;    END&#xA;&#xA;    SET @date = DATEADD(DAY, 1, @date);&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
